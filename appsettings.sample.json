{
  "Window": {
    "Title": "Aplicativo de Mensagens Web",
    "IconPath": "",
    "Width": 1280,
    "Height": 850,
    "StartMinimized": false,
    "StartHiddenInTray": false,
    "CloseToTray": true,
    "MinimizeToTray": false,
    "KeepInTaskbarOnClose": true
  },
  "Web": {
    "Url": "https://messaging.example.com",
    "UserDataFolder": "%LOCALAPPDATA%\\WebTrayHost\\Perfis\\ContaSecundaria",
    "UserAgent": ""
  },
  "Notifications": {
    "EnableCustomToastNotifications": true,
    "ShowTrayUnreadBadge": true,
    "TaskbarBadgeColor": "#D13438", // Cor azul anterior: "#60CDFF" (ou "Auto" para cor nativa do Windows)
    "MonitorDocumentTitle": true,
    "TitleNotificationRegex": "^\\((\\d+)\\)",
    "PlaySound": true
  }
}
